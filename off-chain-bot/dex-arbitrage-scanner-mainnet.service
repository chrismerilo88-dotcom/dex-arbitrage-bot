# Runs the off-chain-bot scanner continuously against real Ethereum
# mainnet, in DRY_RUN mode only (see .env.mainnet) -- accumulates real
# opportunity observations toward the 100+ simulated-opportunity
# milestone from notes/06 - Pre-Mainnet Checklist.md's "before real
# funds" bar. WATCH_MODE=true in .env.mainnet reacts to every new block,
# maximizing observation rate versus a scheduled/manual run.
#
# Template of the unit actually installed on this project's dev machine
# -- paths below are specific to that machine. To install elsewhere:
#   cp off-chain-bot/dex-arbitrage-scanner-mainnet.service ~/.config/systemd/user/
#   # edit the two paths below for the new machine
#   systemctl --user daemon-reload
#   systemctl --user enable --now dex-arbitrage-scanner-mainnet.service
#   loginctl enable-linger $USER   # keeps it running without an active login session
# Check on it: systemctl --user status dex-arbitrage-scanner-mainnet.service
# Logs: journalctl --user -u dex-arbitrage-scanner-mainnet.service -f
#   (also written to shared/logs/, see shared/logger.js)
[Unit]
Description=DexArbitrageBotFlashLoan off-chain scanner (Ethereum Mainnet, DRY_RUN only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/chrismerilo88/dex-arbitrage-bot/off-chain-bot
EnvironmentFile=/home/chrismerilo88/dex-arbitrage-bot/off-chain-bot/.env.mainnet
ExecStart=/home/chrismerilo88/.nvm/versions/node/v24.19.0/bin/node index.js
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

# Runs the off-chain-bot scanner continuously against real BNB Smart
# Chain, in DRY_RUN mode only (see .env.bnb-mainnet). PancakeSwap V3
# only for now, single protocol -- same phased approach as Ethereum
# Mainnet before Arbitrum's cross-DEX expansion. SCAN_CONCURRENCY is
# deliberately 1 here (see .env.bnb-mainnet's own comment) -- the free
# public RPC silently fails under concurrent load, confirmed live.
#
# Template of the unit actually installed on this project's dev machine
# -- paths below are specific to that machine. To install elsewhere:
#   cp off-chain-bot/dex-arbitrage-scanner-bnb-mainnet.service ~/.config/systemd/user/
#   # edit the two paths below for the new machine
#   systemctl --user daemon-reload
#   systemctl --user enable --now dex-arbitrage-scanner-bnb-mainnet.service
#   loginctl enable-linger $USER   # keeps it running without an active login session
# Check on it: systemctl --user status dex-arbitrage-scanner-bnb-mainnet.service
# Logs: journalctl --user -u dex-arbitrage-scanner-bnb-mainnet.service -f
#   (also written to shared/logs/, see shared/logger.js)
[Unit]
Description=DexArbitrageBotFlashLoan off-chain scanner (BNB Chain Mainnet, DRY_RUN only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/chrismerilo88/dex-arbitrage-bot/off-chain-bot
EnvironmentFile=/home/chrismerilo88/dex-arbitrage-bot/off-chain-bot/.env.bnb-mainnet
ExecStart=/home/chrismerilo88/.nvm/versions/node/v24.19.0/bin/node index.js
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

# Runs the off-chain-bot scanner continuously against real Arbitrum
# mainnet, in DRY_RUN mode only (see .env.arbitrum-mainnet). Unlike the
# Ethereum mainnet scanner, this one covers TWO protocols on the same
# WETH/USDC pair (Uniswap V3 + SushiSwap V2) specifically to generate
# genuine cross-DEX candidates -- same-protocol-different-fee-tier
# scanning on Ethereum mainnet turned out to already be fully arbitraged.
#
# Template of the unit actually installed on this project's dev machine
# -- paths below are specific to that machine. To install elsewhere:
#   cp off-chain-bot/dex-arbitrage-scanner-arbitrum-mainnet.service ~/.config/systemd/user/
#   # edit the two paths below for the new machine
#   systemctl --user daemon-reload
#   systemctl --user enable --now dex-arbitrage-scanner-arbitrum-mainnet.service
#   loginctl enable-linger $USER   # keeps it running without an active login session
# Check on it: systemctl --user status dex-arbitrage-scanner-arbitrum-mainnet.service
# Logs: journalctl --user -u dex-arbitrage-scanner-arbitrum-mainnet.service -f
#   (also written to shared/logs/, see shared/logger.js)
[Unit]
Description=DexArbitrageBotFlashLoan off-chain scanner (Arbitrum Mainnet, DRY_RUN only, cross-DEX)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/chrismerilo88/dex-arbitrage-bot/off-chain-bot
EnvironmentFile=/home/chrismerilo88/dex-arbitrage-bot/off-chain-bot/.env.arbitrum-mainnet
ExecStart=/home/chrismerilo88/.nvm/versions/node/v24.19.0/bin/node index.js
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

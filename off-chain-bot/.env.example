# Copy to .env and fill in. Never commit the real .env.
#
# RPC_URL accepts either an https:// or a wss:// endpoint. wss:// is
# recommended when WATCH_MODE=true -- block events arrive as a push over
# the open socket instead of via HTTPS polling, a real latency win
# (confirmed live against Alchemy's testnet endpoints, same API key, just
# swap the scheme: wss://<host>/v2/<key> instead of https://...). Plain
# https:// still works fine for one-shot (non-WATCH_MODE) runs.
RPC_URL=
PRIVATE_KEY=
EXECUTOR_ADDRESS=

# Opportunity-discovery scan config -- see notes/03 - Address Registry.md
# for which adapter/token addresses are actually confirmed live+approved
# on a given network. ADAPTERS, BORROWED_ASSET, and VIA_TOKENS are all
# required for main() to scan anything.
#
# ADAPTERS: comma-separated `address:protocol` list of DEX adapters to
#   route through -- protocol is one of v2, v3, curve, balancer, and
#   defaults to v3 if omitted (matching this project's original
#   single-adapter config, e.g. `0xAbC...` alone still works unchanged).
#   Getting the protocol tag right matters: it controls how routeData's
#   `extra` field gets encoded, and each protocol expects a different
#   shape -- see the adapter contracts themselves (UniswapV2Adapter.sol,
#   UniswapV3Adapter.sol, CurveAdapter.sol, BalancerAdapter.sol) for the
#   exact encoding each one decodes on-chain.
#     - v2/v3 are token-agnostic: every adapter1 x adapter2 combination
#       among your v2/v3 adapters gets scanned against every VIA_TOKENS
#       entry automatically.
#     - curve: the adapter's own pool is queried on-chain at startup
#       (coins(0)/coins(1)) to discover which token pair it actually
#       trades -- no via-token search needed or possible, since one
#       Curve adapter instance is bound to one already-deployed pool.
#     - balancer: encoding is implemented (see encodeBalancerRouteData in
#       index.js) but candidate generation isn't wired up yet -- a
#       poolId isn't derivable from just the vault/token addresses the
#       way Curve's coin indices are, and there's no real Balancer pool
#       verified live on either testnet yet to design that against. See
#       the comment above buildCandidates() in index.js for what adding
#       one would need.
#   Example: `0xRouter02Adapter:v3,0xSushiV2Adapter:v2,0x3poolAdapter:curve`
# BORROWED_ASSET: the token main() borrows and must return to (e.g. WETH).
#   Its on-chain decimals() is read automatically at startup -- SCAN_AMOUNT
#   and MIN_PROFIT below are parsed in *this* token's units, not always 18
#   (e.g. USDC is 6). The WETH-only gas-cost adjustment (see tryRoute() in
#   index.js) only applies when this is actually the network's WETH.
# VIA_TOKENS: comma-separated list of other approved tokens to route
#   through, e.g. USDC,WSOL addresses on Ethereum Sepolia. With 2 or more
#   configured, triangular routes (BORROWED_ASSET -> viaA -> viaB ->
#   BORROWED_ASSET) are scanned automatically alongside the plain 2-hop
#   round trips, for v2/v3 adapters -- see buildCandidates() in index.js.
ADAPTERS=
BORROWED_ASSET=
VIA_TOKENS=

# Optional scan tuning -- all have defaults in index.js if left blank.
# FEE_TIERS: comma-separated Uniswap V3 fee tiers to try per hop (default: 500,3000,10000). v2/curve legs ignore this entirely.
# SCAN_AMOUNT: amount of BORROWED_ASSET to test per candidate, in BORROWED_ASSET's own decimal units (default: 1)
# MIN_PROFIT: minimum profit to submit a request, in BORROWED_ASSET's own decimal units (default: 0.01)
# SLIPPAGE_BPS: max slippage per leg in basis points (default: 300)
# SCAN_CONCURRENCY: how many quoteRoute() calls to fire in parallel per
#   batch (default: 20) -- candidate count grows combinatorially with
#   ADAPTERS x VIA_TOKENS x FEE_TIERS, so this caps how hard a broad scan
#   hits your RPC provider at once.
# WATCH_MODE: set to "true" to re-scan on every new block instead of
#   running once and exiting (Ctrl+C to stop). Uses a wss:// RPC_URL if
#   you've set one (see above); falls back to HTTPS polling otherwise.
# CONFIRMATION_TIMEOUT_MS: how long to wait for a submitted tx to confirm
#   before treating it as stuck and freeing its nonce with a cancellation
#   tx (default: 120000 = 2 minutes). Also bounds the cancellation tx's
#   own confirmation wait, so a relay that won't even confirm a bare
#   self-transfer can't block this process forever either.
# ALLOW_UNKNOWN_SUBMIT_RELAY: set to "true" to allow a SUBMIT_RPC_URL host
#   not on the known-private-relay allowlist in index.js (rpc.flashbots.net,
#   rpc.mevblocker.io, mainnet.base.org) on a mainnet chain. Off by default
#   so a typo'd or misconfigured relay fails loudly instead of silently
#   submitting with no MEV protection.
FEE_TIERS=
SCAN_AMOUNT=
MIN_PROFIT=
SLIPPAGE_BPS=
SCAN_CONCURRENCY=
WATCH_MODE=
CONFIRMATION_TIMEOUT_MS=
ALLOW_UNKNOWN_SUBMIT_RELAY=

# Where requestFlashLoanArbitrage actually gets submitted -- separate from
# RPC_URL (used for all read-only calls) so submission can go through a
# private relay instead of the public mempool. Falls back to RPC_URL when
# left blank, so testnets work with no extra config.
#
# Network-dependent -- this is NOT the same endpoint on every chain:
#   - Ethereum mainnet: a private relay, e.g. Flashbots Protect
#     (https://rpc.flashbots.net) or MEV Blocker (https://rpc.mevblocker.io),
#     so the tx never sits in the public mempool for a searcher to copy.
#   - Base mainnet: Base runs a single sequencer, not a public-mempool-plus-
#     builder-auction model, so the private-relay concept above doesn't
#     apply the same way -- point this at Base's own official RPC instead.
#     Verify current best practice for this closer to actual mainnet launch
#     rather than assuming it hasn't changed.
#   - Testnets (Sepolia, Base Sepolia): leave blank, falls back to RPC_URL.
SUBMIT_RPC_URL=

# Copy to .env and fill in. Never commit the real .env.
RPC_URL=
PRIVATE_KEY=
EXECUTOR_ADDRESS=
UNISWAP_V2_ADAPTER=
SUSHISWAP_V2_ADAPTER=

# Where requestFlashLoanArbitrage actually gets submitted -- separate from
# RPC_URL (used for all read-only calls) so submission can go through a
# private relay instead of the public mempool. Falls back to RPC_URL when
# left blank, so testnets work with no extra config.
#
# Network-dependent -- this is NOT the same endpoint on every chain:
#   - Ethereum mainnet: a private relay, e.g. Flashbots Protect
#     (https://rpc.flashbots.net) or MEV Blocker (https://rpc.mevblocker.io),
#     so the tx never sits in the public mempool for a searcher to copy.
#   - Base mainnet: Base runs a single sequencer, not a public-mempool-plus-
#     builder-auction model, so the private-relay concept above doesn't
#     apply the same way -- point this at Base's own official RPC instead.
#     Verify current best practice for this closer to actual mainnet launch
#     rather than assuming it hasn't changed.
#   - Testnets (Sepolia, Base Sepolia): leave blank, falls back to RPC_URL.
SUBMIT_RPC_URL=
